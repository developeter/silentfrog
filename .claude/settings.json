{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "model": "opus",
  "effortLevel": "xhigh",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_bare_commit.py"
            ],
            "timeout": 10,
            "statusMessage": "Caveman: checking commit form…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/route_caveman.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/staged_changes_reminder.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
