#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[silentfrog pre-push] Running full doctor checks..."
# diff-cover compares against origin/dev — locally the pre-push hook
# runs BEFORE the push reaches the remote, so the compare branch is
# the previous tip. That's fine, but enforcing the 85% per-file
# threshold locally creates push churn for transient WIP commits.
# CI re-runs the gate on every PR with the full server-side history
# and IS the canonical enforcement point. Skip it here.
poetry run python tools/doctor.py --skip-diff-cover
